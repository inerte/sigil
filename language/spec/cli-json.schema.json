{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sigil-lang.org/spec/cli-json.schema.json",
  "title": "Sigil canonical machine output (formatVersion 1)",
  "type": "object",
  "required": [
    "formatVersion",
    "compilerVersion",
    "command",
    "ok",
    "phase",
    "analysis",
    "data",
    "diagnostics"
  ],
  "properties": {
    "formatVersion": { "const": 1 },
    "compilerVersion": { "type": "string", "minLength": 1 },
    "command": { "type": "string", "pattern": "^sigil(?: |$)" },
    "ok": { "type": "boolean" },
    "phase": { "$ref": "#/$defs/phase" },
    "analysis": { "$ref": "#/$defs/analysis" },
    "data": { "type": "object" },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "#/$defs/diagnostic" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "phase": {
      "type": "string",
      "enum": [
        "cli",
        "io",
        "surface",
        "lexer",
        "parser",
        "canonical",
        "typecheck",
        "proof",
        "topology",
        "mutability",
        "extern",
        "codegen",
        "runtime",
        "docs",
        "package",
        "internal"
      ]
    },
    "analysis": {
      "type": "object",
      "required": ["status", "level"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["complete", "partial", "failed", "notApplicable"]
        },
        "level": {
          "type": "string",
          "enum": ["none", "lexed", "parsed", "canonical", "typed", "generated", "executed", "mixed"]
        }
      },
      "additionalProperties": false
    },
    "sourcePoint": {
      "type": "object",
      "required": ["line", "column"],
      "properties": {
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 0 },
        "offset": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "sourceSpan": {
      "type": "object",
      "required": ["file", "start"],
      "properties": {
        "file": { "type": "string" },
        "start": { "$ref": "#/$defs/sourcePoint" },
        "end": { "$ref": "#/$defs/sourcePoint" }
      },
      "additionalProperties": false
    },
    "relatedLocation": {
      "type": "object",
      "required": ["message", "location"],
      "properties": {
        "message": { "type": "string" },
        "location": { "$ref": "#/$defs/sourceSpan" }
      },
      "additionalProperties": false
    },
    "fixit": {
      "type": "object",
      "required": ["kind", "range", "applicability"],
      "properties": {
        "kind": { "type": "string", "enum": ["replace", "insert", "delete"] },
        "range": { "$ref": "#/$defs/sourceSpan" },
        "applicability": {
          "type": "string",
          "enum": ["machineApplicable", "requiresReview"]
        },
        "text": { "type": "string" }
      },
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "required": ["code", "phase", "severity", "message"],
      "properties": {
        "code": { "type": "string", "pattern": "^SIGIL-[A-Z0-9-]+$" },
        "phase": { "$ref": "#/$defs/phase" },
        "severity": { "type": "string", "enum": ["error", "warning", "info"] },
        "message": { "type": "string" },
        "location": { "oneOf": [{ "$ref": "#/$defs/sourceSpan" }, { "type": "null" }] },
        "relatedLocations": {
          "type": "array",
          "items": { "$ref": "#/$defs/relatedLocation" }
        },
        "found": true,
        "expected": true,
        "details": { "type": "object" },
        "fixits": { "type": "array", "items": { "$ref": "#/$defs/fixit" } },
        "suggestions": { "type": "array", "items": { "type": "object" } }
      },
      "additionalProperties": false
    }
  }
}
